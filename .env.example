# =============================================================================
# Elastic Alert Analyzer — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Elasticsearch (required for alert fetch / investigation)
# -----------------------------------------------------------------------------
ELASTIC_URL=https://your-deployment.es.region.cloud.es.io
ELASTIC_API_KEY=your_elastic_api_key_here

# Alert index / data stream used by the pipeline fetch
ALERTS_INDEX=.internal.alerts-security.alerts-default-000001

# Index pattern for endpoint / system telemetry (investigation queries)
LOGS_INDEX=logs-*

# -----------------------------------------------------------------------------
# Investigation
# -----------------------------------------------------------------------------
# Time window around the alert timestamp (± minutes)
INVESTIGATION_WINDOW_MINUTES=5

# Max documents returned per investigation subquery
INVESTIGATION_SIZE=50

# -----------------------------------------------------------------------------
# Threat Intelligence API keys (optional — lookups skip if unset / failing)
# -----------------------------------------------------------------------------
VT_API_KEY=
ABUSEIPDB_API_KEY=
HYBRID_ANALYSIS_API_KEY=
SHODAN_API_KEY=

# -----------------------------------------------------------------------------
# LLM summary (optional — rule-based fallback used if unset / failing)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# -----------------------------------------------------------------------------
# Reports
# -----------------------------------------------------------------------------
REPORTS_DIR=reports
SAVE_REPORTS=true

# -----------------------------------------------------------------------------
# IOC cache / historical correlation
# -----------------------------------------------------------------------------
CACHE_DB_PATH=cache.db
CACHE_TTL_HOURS=24
HISTORY_LOOKBACK_DAYS=30

# -----------------------------------------------------------------------------
# Pipeline scheduling & state
# -----------------------------------------------------------------------------
# Default lookback (minutes) when state.json does not exist.
# Keep this aligned with the Windows Task Scheduler interval (e.g. 30).
PIPELINE_INTERVAL_MINUTES=30

# Cursor file written after each successful run
PIPELINE_STATE_FILE=state.json

# Elasticsearch search_after page size (not a result cap)
ALERTS_PAGE_SIZE=500

# -----------------------------------------------------------------------------
# Pipeline scalability & reliability (optional)
# -----------------------------------------------------------------------------
# How many completed alert reports to keep in memory before staging to disk.
PIPELINE_BATCH_SIZE=100

# Max retry attempts for transient Elasticsearch / TI HTTP failures.
# Backoff uses PIPELINE_RETRY_DELAY as the base (default 1 → waits 1s, 2s, 5s).
PIPELINE_MAX_RETRIES=3

# Base retry delay in seconds (multiplied as 1x, 2x, 5x for the first 3 retries).
PIPELINE_RETRY_DELAY=1

# Soft cap on alerts processed in a single run.
# Use None (or leave unset) for unlimited. Example: 500
PIPELINE_MAX_ALERTS_PER_RUN=None

# -----------------------------------------------------------------------------
# Pipeline logging
# -----------------------------------------------------------------------------
PIPELINE_LOGS_DIR=logs

# Optional fixed log filename. Leave unset for daily rotation:
#   logs/pipeline_YYYY-MM-DD.log
# PIPELINE_LOG_FILE=pipeline.log
